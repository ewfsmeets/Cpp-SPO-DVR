        given-names: G. J.
      - family-names: Somers
        given-names: M. F.
    title: "Six-dimensional dynamics of dissociative chemisorption of H₂ on metal surfaces"
    journal: "Journal of Theoretical and Computational Chemistry"
    volume: 4
    issue: 2
    start: 493
    end: 581
    year: 2005
    month: 6
    doi: 10.1142/S0219633605001647
