# Writes OUTPUT, a C++ source that defines spodvr::git_description(), from
# `git describe --always --dirty` in SOURCE_DIR ("unknown" outside a git checkout or without git).
# The file is rewritten only when the description changes, so that only the spodvr executable
# relinks. Run at every build by the target spodvr_git_description (CMakeLists.txt):
#   cmake -DSOURCE_DIR=<repository> -DOUTPUT=<file> -P cmake/git_describe.cmake
execute_process(COMMAND git describe --always --dirty
                WORKING_DIRECTORY "${SOURCE_DIR}"
                OUTPUT_VARIABLE description
                OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET
                RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR description STREQUAL "")
  set(description "unknown")
endif()
# One string from quoted pieces (an unquoted list would lose the ';' of the return statement).
string(CONCAT content "// Generated by cmake/git_describe.cmake at build time: do not edit.\n"
                      "#include \"app/git_description.hpp\"\n\n"
                      "std::string_view spodvr::git_description() { return \"${description}\"; }\n")
set(old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
